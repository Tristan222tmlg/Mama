{#- Eine Pflanze mit ihren Tieren als Trabanten. Erwartet: po (Pflanze aus pflanzen.yml) -#}
{%- set plaetze = po.beziehungen | length | plaetze %}
<figure class="pflanzenorbit">
<div class="po-kreis">
{%- if po.foto %}
<div class="po-bild">{% foto po.foto, po.foto_alt, "(min-width: 56rem) 20rem, 60vw" %}</div>
{%- else %}
<div class="po-bild po-leer farbe-{{ po.bluetenfarbe or 'gruen' }}"><svg class="sym" aria-hidden="true" focusable="false"><use href="#i-flower"/></svg></div>
{%- endif %}
{% include "teile/ring.njk" %}
</div>
<ul class="po-tiere" aria-label="Tiere, die {{ po.name }} nutzen">
{%- for b in po.beziehungen %}{% if loop.index <= 4 %}
{%- set platz = plaetze[loop.index0] %}
<li class="po-tier slot-{{ platz }}{% if platz >= 5 %} seite-links{% endif %}"><span class="po-symbol art-{{ b.art }}"><svg class="sym" aria-hidden="true" focusable="false"><use href="#i-{{ b.tier | tiergruppe }}"/></svg></span><span class="po-name">{{ b.tier }}</span></li>
{%- endif %}{% endfor %}
</ul>
</figure>
