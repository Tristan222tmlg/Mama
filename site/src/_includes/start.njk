---
layout: basis.njk
---
<section class="held" aria-labelledby="held-titel">
<div class="wrap held-raster">
<div class="held-text">
<p class="kicker">{{ kicker }}</p>
<h1 class="held-titel" id="held-titel">{{ ueberschrift | betont | safe }}</h1>
<p class="lead">{{ lead }}</p>
<p class="knoepfe">
{%- for k in knoepfe %}
<a class="knopf{% if not loop.first %} knopf-zwei{% endif %}" href="{{ base }}{{ k.ziel }}">{{ k.text }}</a>
{%- endfor %}
</p>
</div>
<figure class="komposition">
{% include "teile/ring.njk" %}
<div class="kreis kreis-gross">{% foto bilder[0].datei, bilder[0].alt, "(min-width: 56rem) 26rem, 72vw", true %}</div>
<div class="kreis kreis-a">{% foto bilder[1].datei, bilder[1].alt, "(min-width: 56rem) 10rem, 28vw" %}</div>
<div class="kreis kreis-b">{% foto bilder[2].datei, bilder[2].alt, "(min-width: 56rem) 8rem, 22vw" %}</div>
<figcaption class="notiz">{% include "teile/pfeil.njk" %}<span>{{ bilder[0].notiz }}</span></figcaption>
</figure>
</div>
</section>

<section class="abschnitt" aria-labelledby="worum-titel">
<div class="wrap zwei-spalten">
<div class="spalte-text">
<h2 id="worum-titel">{{ worum.titel }}</h2>
{{ worum.text | renderContent("md") | safe }}
</div>
{% include "teile/stern.njk" %}
</div>
</section>

<section class="abschnitt band-salbei" aria-labelledby="nutzen-titel">
<div class="wrap zwei-spalten umgekehrt">
<div class="spalte-text">
<h2 id="nutzen-titel">{{ nutzen.titel }}</h2>
{{ nutzen.text | renderContent("md") | safe }}
</div>
{% include "teile/trittsteine.njk" %}
</div>
</section>

<section class="abschnitt band-wald programm" aria-labelledby="programm-titel">
<div class="wrap">
<p class="kicker">{{ programm.kicker }}</p>
<h2 id="programm-titel">{{ programm.titel }}</h2>
{% include "teile/wochen.njk" %}
<div class="programm-text">
{{ programm.text | renderContent("md") | safe }}
</div>
<p><a class="knopf knopf-hell" href="{{ base }}online-programm.html">So läuft das Programm ab</a></p>
</div>
</section>

<section class="abschnitt" aria-label="Rückmeldung einer Kundin">
<div class="wrap">
<figure class="zitat-gross">
<blockquote><p>{{ zitat.text }}“</p></blockquote>
<figcaption>{{ zitat.quelle }}</figcaption>
</figure>
</div>
</section>

<section class="abschnitt ich-abschnitt" aria-labelledby="ich-titel">
<div class="wrap ich-raster">
<figure class="portrait">
{% include "teile/ring.njk" %}
<div class="kreis">{% foto ich.bild, ich.bild_alt, "13rem" %}</div>
</figure>
<div class="spalte-text">
<h2 id="ich-titel">{{ ich.titel }}</h2>
{{ ich.text | renderContent("md") | safe }}
</div>
</div>
</section>

{% include "teile/abschluss.njk" %}
