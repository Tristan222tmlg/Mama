---
layout: basis.njk
kopf_dunkel: true
grafik_js: true
---
<section class="held dunkel" aria-labelledby="held-titel">
<div class="wrap held-innen">
{%- set orbit = bilder %}
{% include "teile/orbit.njk" %}
<h1 id="held-titel">{{ ueberschrift | betont | safe }}</h1>
<p class="lead">{{ lead }}</p>
<p class="aktionen">
<a class="knopf" href="{{ base }}{{ knoepfe[0].ziel }}">{{ knoepfe[0].text }}</a>
<a class="weiter" href="{{ base }}{{ knoepfe[1].ziel }}">{{ knoepfe[1].text }}</a>
</p>
</div>
</section>

<div class="aussage">
<div class="wrap">
<p class="aussage-text">Die Tiere <span class="chip">{% foto chips[0], "", "8rem" %}</span> sucht man nicht aus. Man sucht die Pflanzen <span class="chip">{% foto chips[1], "", "8rem" %}</span> aus, die mit besonders vielen Tieren in Beziehung stehen.</p>
</div>
</div>

<section class="abschnitt abschnitt-oben-eng" aria-labelledby="worum-titel">
<div class="wrap zwei">
<div class="links">
<h2 id="worum-titel">{{ worum.titel }}</h2>
{{ worum.text | renderContent("md") | safe }}
<p><a class="weiter" href="{{ base }}pflanzen-und-tiere.html">Alle Pflanzen und Tiere, mit Quellen</a></p>
</div>
<div class="rechts">
{%- set po = pflanzen.pflanzen[0] %}
{% include "teile/pflanzenorbit.njk" %}
</div>
</div>
</section>

<section class="abschnitt licht" aria-labelledby="nutzen-titel">
<div class="wrap zwei breit-links">
<div class="links">{% include "teile/trittsteine.njk" %}</div>
<div class="rechts">
<h2 id="nutzen-titel">{{ nutzen.titel }}</h2>
{{ nutzen.text | renderContent("md") | safe }}
</div>
</div>
</section>

<section class="abschnitt blau programm" aria-labelledby="programm-titel">
<div class="wrap">
<h2 id="programm-titel">{{ programm.titel }}</h2>
{% include "teile/wochen.njk" %}
<ul class="bausteine">
{%- for b in programm.bausteine %}
<li>{{ b }}</li>
{%- endfor %}
</ul>
<p class="aktionen"><a class="knopf" href="{{ base }}online-programm.html">So läuft das Programm ab</a><span>{{ programm.erstgespraech }}</span></p>
</div>
</section>

<section class="abschnitt sanft" aria-labelledby="rad-titel">
<div class="wrap">
{%- set rad_titel = "Was wann blüht" %}
{% include "teile/rad.njk" %}
</div>
</section>

<section class="zitat-band dunkel" aria-label="Rückmeldung einer Kundin">
<div class="wrap">
<figure class="zitat-gross">
<blockquote><p>„{{ zitat.text }}“</p></blockquote>
<figcaption>{{ zitat.quelle }}</figcaption>
</figure>
</div>
</section>

<section class="abschnitt abschnitt-oben-eng" aria-labelledby="ich-titel">
<div class="wrap zwei">
<div class="links">
<figure class="portrait-orbit">
<div class="orbit-kugel"></div>
<div class="po-bild">{% foto ich.bild, ich.bild_alt, "18rem" %}</div>
{% include "teile/ring.njk" %}
</figure>
</div>
<div class="rechts">
<h2 id="ich-titel">{{ ich.titel }}</h2>
{{ ich.text | renderContent("md") | safe }}
</div>
</div>
</section>

{% include "teile/abschluss.njk" %}
